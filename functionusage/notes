// Вложенные функции-когда в одной функции мы создаем еще одну
function outerFoo(){
    const outerVar = 'Test';
    console.log(outerVar); 

function innerFoo() {
    const innerVar = 'Test inner';
    console.log(innerVar); 
}
innerFoo();
}
outerFoo();